# =============================================================================
# AI Sales Assistant - variables de entorno (DESARROLLO)
# No edites secretos a mano: ejecuta  ./infrastructure/scripts/setup.sh
# que copia este archivo a .env y sustituye cada __GENERATE__ por un valor
# aleatorio criptográficamente seguro. .env NUNCA se sube al repositorio.
# =============================================================================

# Perfiles de docker compose a levantar (separados por coma):
#   automation = n8n | chatwoot = Chatwoot | evolution = Evolution API
COMPOSE_PROFILES=automation,chatwoot
TZ=America/Lima

# ---------- PostgreSQL (servidor compartido en desarrollo) -------------------
POSTGRES_HOST_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__

APP_DB_NAME=ai_sales
APP_DB_USER=ai_sales
APP_DB_PASSWORD=__GENERATE__
# Rol de ejecución (RLS obligatoria) y rol de sistema (BYPASSRLS, uso acotado)
APP_DB_RUNTIME_USER=ai_sales_app
APP_DB_RUNTIME_PASSWORD=__GENERATE__
APP_DB_SYSTEM_USER=ai_sales_system
APP_DB_SYSTEM_PASSWORD=__GENERATE__

CHATWOOT_DB_NAME=chatwoot
CHATWOOT_DB_USER=chatwoot
CHATWOOT_DB_PASSWORD=__GENERATE__

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=__GENERATE__

EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=__GENERATE__

# ---------- Redis -------------------------------------------------------------
REDIS_HOST_PORT=6380
REDIS_PASSWORD=__GENERATE__

# ---------- n8n -----------------------------------------------------------------
N8N_VERSION=3.2.0
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=__GENERATE__
N8N_WEBHOOK_URL=http://localhost:5678/
# Token compartido para llamadas backend <-> n8n (cabecera X-Internal-Token)
N8N_INTERNAL_TOKEN=__GENERATE__
# URL del backend vista desde el contenedor de n8n
N8N_API_BASE_URL=http://host.docker.internal:4000

# ---------- Chatwoot ------------------------------------------------------------
CHATWOOT_VERSION=v4.19.1
CHATWOOT_HOST_PORT=3100
CHATWOOT_FRONTEND_URL=http://localhost:3100
CHATWOOT_SECRET_KEY_BASE=__GENERATE__
CHATWOOT_MAILER_SENDER_EMAIL="AI Sales Assistant <no-reply@localhost>"
# Se rellenan en FASE 5 (token de Platform App / usuario administrador)
CHATWOOT_PLATFORM_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# ---------- Evolution API (solo si COMPOSE_PROFILES incluye evolution) -----------
EVOLUTION_VERSION=v2.3.7
EVOLUTION_HOST_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=__GENERATE__

# ---------- WhatsApp Cloud API (Meta) - FASE 4 -------------------------------------
# Se obtienen en developers.facebook.com > tu App > WhatsApp. Nunca en el código.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=__GENERATE__

# ---------- Dify (proyecto compose oficial aparte) - FASE 6 ----------------------
DIFY_VERSION=1.19.0
DIFY_VECTOR_STORE=pgvector
DIFY_HTTP_PORT=8090
DIFY_API_URL=http://localhost:8090/v1
DIFY_APP_API_KEY=

# ---------- API (apps/api) ------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=__GENERATE__
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Clave maestra AES-256-GCM para cifrar tokens de terceros guardados en BD
DATA_ENCRYPTION_KEY=__GENERATE__
TRIAL_DAYS=14
MAIL_FROM="AI Sales Assistant <no-reply@localhost>"
# Administrador general de la plataforma (lo crea el seed)
PLATFORM_ADMIN_EMAIL=admin@localhost.test
PLATFORM_ADMIN_PASSWORD=__GENERATE__

# ---------- SMTP (verificación de correo / recuperación de contraseña) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
