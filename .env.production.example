# =============================================================================
# AI Sales Assistant - variables de PRODUCCIÓN
# 1) cp .env.production.example .env.production   (en el servidor, nunca en git)
# 2) ./infrastructure/scripts/deploy.sh --init      sustituye cada __GENERATE__
#    por un secreto aleatorio y deja el archivo con permisos 600
# 3) Completa a mano lo marcado como OBLIGATORIO
# Guía: docs/installation/production.md
# =============================================================================

# ---------- Dominio y HTTPS (OBLIGATORIO) -------------------------------------
# Dominio del panel y de la API (un registro DNS A apuntando a este servidor)
APP_DOMAIN=ventas.tu-dominio.com
# Correo para Let's Encrypt (avisos de caducidad de certificados)
ACME_EMAIL=tu-correo@tu-dominio.com
# Solo pruebas sin dominio real: local_certs (certificado propio de Caddy)
CADDY_GLOBAL_OPTIONS=
TZ=America/Lima
APP_VERSION=latest

# ---------- Correo SMTP real (OBLIGATORIO) ------------------------------------
# Proveedores habituales: Amazon SES, Brevo, Mailgun, Postmark, Google Workspace
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ventas <no-reply@tu-dominio.com>"

# ---------- Administrador general de la plataforma (OBLIGATORIO) --------------
PLATFORM_ADMIN_EMAIL=tu-correo@tu-dominio.com
PLATFORM_ADMIN_PASSWORD=__GENERATE__

# ---------- Secretos (los genera deploy.sh --init) ----------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
APP_DB_NAME=ai_sales
APP_DB_USER=ai_sales
APP_DB_PASSWORD=__GENERATE__
APP_DB_RUNTIME_USER=ai_sales_app
APP_DB_RUNTIME_PASSWORD=__GENERATE__
APP_DB_SYSTEM_USER=ai_sales_system
APP_DB_SYSTEM_PASSWORD=__GENERATE__
CHATWOOT_DB_PASSWORD=__GENERATE__
N8N_DB_PASSWORD=__GENERATE__
EVOLUTION_DB_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
JWT_SECRET=__GENERATE__
# Clave maestra AES-256-GCM de los tokens de terceros. Si se pierde, hay que
# volver a introducir las credenciales de WhatsApp y Chatwoot de cada empresa.
DATA_ENCRYPTION_KEY=__GENERATE__
TRIAL_DAYS=14
# Días de gracia tras vencer un plan pagado antes de pasar a solo lectura
BILLING_GRACE_DAYS=3
# Instrucciones de pago que ven las empresas en el panel (Yape, cuenta bancaria, WhatsApp de contacto)
BILLING_CONTACT=

# ---------- IA (Gemini) ---------------------------------------------------------
# Clave de Google AI Studio. En producción usa un plan de pago: en el gratuito
# Google puede usar los mensajes para mejorar sus productos.
GEMINI_API_KEY=
# Modelo de Gemini (https://ai.google.dev/gemini-api/docs/models). Más barato: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# ---------- WhatsApp Cloud API ---------------------------------------------------
# Las credenciales de cada número las introduce cada empresa en Integraciones.
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_APP_SECRET=

# ---------- Opcional: automatizaciones (perfil "automation") -------------------
# Para activarlas: COMPOSE_PROFILES=automation y N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_ENCRYPTION_KEY=__GENERATE__
N8N_INTERNAL_TOKEN=__GENERATE__
N8N_WEBHOOK_BASE_URL=

# ---------- Opcional: bandeja de agentes Chatwoot (perfil "chatwoot") ----------
# Requiere un segundo dominio y infrastructure/caddy/extra/chatwoot.caddy
CHATWOOT_DOMAIN=
CHATWOOT_SECRET_KEY_BASE=__GENERATE__
CHATWOOT_PLATFORM_TOKEN=

# Perfiles opcionales separados por coma: automation, chatwoot
COMPOSE_PROFILES=
LOG_LEVEL=info
