// =============================================================================
// AI Sales Assistant - esquema de datos (PostgreSQL 17, Prisma 7)
//
// Multiempresa: toda tabla de negocio lleva tenant_id. Las políticas RLS se
// definen en las migraciones SQL (database/migrations/*/migration.sql) y se
// aplican al rol de ejecución (sin BYPASSRLS). Convención: modelos en
// PascalCase, tablas/columnas en snake_case.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------- Planes / SaaS

enum PlanCode {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  /// Alta desde la plataforma: el panel funciona, pero el asistente no responde a clientes hasta la activación
  ONBOARDING
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Plan {
  id            String         @id @default(uuid(7)) @db.Uuid
  code          PlanCode       @unique
  name          String
  priceMonthly  Decimal        @map("price_monthly") @db.Decimal(12, 2)
  currency      String         @default("USD") @db.Char(3)
  /// Límites y funciones: { maxUsers, maxWhatsappNumbers, maxConversationsPerMonth, maxProducts, maxBranches, features: string[] }
  limits        Json
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

enum BusinessType {
  RETAIL
  RESTAURANT
  DISTRIBUTOR
  SERVICES
  PHARMACY
  OTHER
}

enum DeploymentMode {
  /// Empresa dentro de la plataforma central (modalidad A)
  SAAS
  /// Instancia propia con su dominio y base de datos (modalidad B)
  DEDICATED
  /// Núcleo común con módulos y automatizaciones adaptados (modalidad C)
  CUSTOM
}

model Tenant {
  id              String         @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String         @unique
  status          TenantStatus   @default(ACTIVE)
  currency        String         @default("PEN") @db.Char(3)
  timezone        String         @default("America/Lima")
  /// Perfil de la empresa (lo edita la propia empresa)
  legalName       String?        @map("legal_name")
  taxId           String?        @map("tax_id")
  country         String         @default("PE") @db.Char(2)
  address         String?
  phone           String?
  contactEmail    String?        @map("contact_email")
  businessType    BusinessType   @default(RETAIL) @map("business_type")
  logoUrl         String?        @map("logo_url")
  brandColor      String?        @map("brand_color")
  /// Solo la plataforma: dominio, modalidad, módulos y plantilla
  customDomain    String?        @unique @map("custom_domain")
  deploymentMode  DeploymentMode @default(SAAS) @map("deployment_mode")
  enabledModules  String[]       @default(["conversations", "ai", "catalog", "inventory", "orders", "customers", "reports", "automations"]) @map("enabled_modules")
  templateKey     String?        @map("template_key")
  /// Versión de la plantilla aplicada (ADR 043)
  templateVersion Int?           @map("template_version")
  /// Reglas de operación de la empresa: catálogo, pedidos, clientes y reservas (tenants/tenant-settings.ts)
  settings        Json           @default("{}")
  /// Clave del asistente de alta: repetir la misma alta devuelve la empresa ya creada
  provisioningKey String?        @unique @map("provisioning_key") @db.Uuid
  activatedAt     DateTime?      @map("activated_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription       Subscription?
  payments           Payment[]
  deliveries         Delivery[]
  salesLead          SalesLead?
  commercialHouse    CommercialSettings[]
  installationOrders InstallationOrder[]
  infraServers       InfraServer[]
  users              User[]
  branches           Branch[]

  @@map("tenants")
}

model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @unique @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(3)
  /// Proveedor de pagos (null hasta configurar uno; no hay cobros reales)
  paymentProvider    String?            @map("payment_provider")
  paymentProviderRef String?            @map("payment_provider_ref")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum PaymentMethod {
  YAPE
  PLIN
  BANK_TRANSFER
  CASH
  OTHER
}

/// Pago registrado a mano por el administrador general (cobro manual, ADR 036).
/// Solo lo escribe el rol de sistema; la empresa puede leer los suyos.
model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  planId       String        @map("plan_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @db.Char(3)
  months       Int
  method       PaymentMethod
  /// Número de operación de Yape, del banco, etc.
  reference    String?
  notes        String?
  paidAt       DateTime      @map("paid_at") @db.Timestamptz(3)
  periodStart  DateTime      @map("period_start") @db.Timestamptz(3)
  periodEnd    DateTime      @map("period_end") @db.Timestamptz(3)
  recordedById String?       @map("recorded_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId, createdAt])
  @@map("payments")
}

enum DeliveryStatus {
  /// Preparada: datos y vista previa, aún sin paquete
  DRAFT
  /// Paquete generado (se puede volver a descargar: es reproducible)
  GENERATED
  /// Entregada al cliente
  DELIVERED
}

/// Entrega de un sistema a un cliente (ADR 044). Solo la plataforma la lee y escribe.
model Delivery {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  number         Int
  systemName     String         @map("system_name")
  deploymentMode DeploymentMode @map("deployment_mode")
  /// Versión de la aplicación con la que se genera el paquete
  appVersion     String         @map("app_version")
  /// Dominio de la instalación independiente (DEDICATED / CUSTOM)
  domain         String?
  supportContact String         @map("support_contact")
  notes          String?
  /// Foto de la empresa al preparar la entrega: módulos, funciones, configuración, requisitos e integraciones pendientes (sin secretos)
  manifest       Json
  status         DeliveryStatus @default(DRAFT)
  packageSha256  String?        @map("package_sha256") @db.Char(64)
  packageBytes   Int?           @map("package_bytes")
  generatedAt    DateTime?      @map("generated_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@map("deliveries")
}

enum SystemUpdateStatus {
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

/// Historial de actualizaciones de esta instalación (ADR 045). Lo escribe el
/// actualizador con el CLI; solo el rol de sistema lo lee.
model SystemUpdate {
  id          String             @id @default(uuid(7)) @db.Uuid
  fromVersion String             @map("from_version")
  toVersion   String             @map("to_version")
  status      SystemUpdateStatus
  /// Migraciones aplicadas durante la actualización
  migrations  Json               @default("[]")
  /// Carpeta del respaldo hecho antes de actualizar
  backupPath  String?            @map("backup_path")
  /// Archivos personalizados que se conservaron, avisos o causa del fallo
  detail      String?
  startedAt   DateTime           @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime           @map("finished_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("system_updates")
}

model UsageCounter {
  tenantId String @map("tenant_id") @db.Uuid
  metric   String
  /// Periodo YYYY-MM
  period   String @db.Char(7)
  value    Int    @default(0)

  @@id([tenantId, metric, period])
  @@map("usage_counters")
}

/// Contadores por empresa (p. ej. numeración de pedidos), incrementados en transacción
model TenantCounter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
  @@map("tenant_counters")
}

// ----------------------------------------------------------------- Usuarios / auth

enum Role {
  PLATFORM_ADMIN
  TENANT_ADMIN
  SUPERVISOR
  SELLER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// null solo para PLATFORM_ADMIN
  tenantId         String?    @map("tenant_id") @db.Uuid
  /// Siempre en minúsculas; único en toda la plataforma
  email            String     @unique
  name             String
  passwordHash     String?    @map("password_hash")
  role             Role
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// Usuario agente en Chatwoot (inicio de sesión único desde el panel)
  chatwootUserId   Int?       @map("chatwoot_user_id")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions   Session[]
  authTokens AuthToken[]
  ownedLeads SalesLead[] @relation("leadOwner")

  @@index([tenantId])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  /// SHA-256 del refresh token (el token en claro nunca se guarda)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// Todas las rotaciones de un mismo inicio de sesión comparten familia
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ----------------------------------------------------------------- Catálogo

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]
  movements   InventoryMovement[]

  @@unique([tenantId, name])
  @@map("branches")
}

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  sku             String
  barcode         String?
  name            String
  description     String?
  salePrice       Decimal       @map("sale_price") @db.Decimal(12, 2)
  costPrice       Decimal?      @map("cost_price") @db.Decimal(12, 2)
  minStock        Int           @default(0) @map("min_stock")
  /// false: servicios y platos preparados; no llevan existencias ni descuentan stock
  trackStock      Boolean       @default(true) @map("track_stock")
  /// Duración de un servicio reservable (minutos)
  durationMinutes Int?          @map("duration_minutes")
  status          ProductStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]
  history  ProductHistory[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@map("products")
}

/// Todo producto tiene al menos una variante (la predeterminada). El stock vive en la variante.
model ProductVariant {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String
  barcode    String?
  /// Nombre legible, p. ej. "Talla 42 / Negro"
  name       String
  /// Atributos, p. ej. { "talla": "42", "color": "negro" }
  attributes Json     @default("{}")
  /// Si es null se usa el precio del producto
  salePrice  Decimal? @map("sale_price") @db.Decimal(12, 2)
  costPrice  Decimal? @map("cost_price") @db.Decimal(12, 2)
  /// Precios por volumen: [{ minQty, unitPrice }] con minQty creciente y precio decreciente
  priceTiers Json     @default("[]") @map("price_tiers")
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]
  movements   InventoryMovement[]
  orderItems  OrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  storageKey String   @map("storage_key")
  url        String
  alt        String?
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  /// { campo: { from, to } }
  changes   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_history")
}

// ----------------------------------------------------------------- Inventario

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  RETURN_IN
  TRANSFER_IN
  TRANSFER_OUT
  SALE_VOID
}

model StockLevel {
  tenantId  String   @map("tenant_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([variantId, branchId])
  @@index([tenantId])
  @@map("stock_levels")
}

/// Libro de movimientos: inmutable. stock_after = stock_before + quantity.
model InventoryMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  variantId      String       @map("variant_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  type           MovementType
  /// Con signo: positivo entra, negativo sale
  quantity       Int
  stockBefore    Int          @map("stock_before")
  stockAfter     Int          @map("stock_after")
  reason         String?
  orderId        String?      @map("order_id") @db.Uuid
  /// Evita aplicar dos veces el mismo movimiento (p. ej. order:<id>:sale:<variant>)
  idempotencyKey String?      @map("idempotency_key")
  /// Movimiento autorizado explícitamente a dejar stock negativo
  allowNegative  Boolean      @default(false) @map("allow_negative")
  userId         String?      @map("user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id])
  branch  Branch         @relation(fields: [branchId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ----------------------------------------------------------------- Clientes / pedidos

model Customer {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  name              String?
  /// E.164 sin "+", tal como lo entrega WhatsApp (p. ej. 51987654321).
  /// Puede faltar: WhatsApp omite el teléfono si el usuario usa nombre de usuario.
  phone             String?
  /// WhatsApp business-scoped user ID (BSUID), p. ej. "US.1349…". Estable por portafolio de negocio.
  waUserId          String?      @map("wa_user_id")
  /// Nombre de perfil de WhatsApp (no confiable: lo escribe el usuario)
  waProfileName     String?      @map("wa_profile_name")
  /// Contacto espejo en Chatwoot y su source_id en el buzón API (FASE 5)
  chatwootContactId Int?         @map("chatwoot_contact_id")
  chatwootSourceId  String?      @map("chatwoot_source_id")
  email             String?
  /// Persona o empresa (cliente comercial de una distribuidora)
  customerType      CustomerType @default(PERSON) @map("customer_type")
  businessName      String?      @map("business_name")
  documentId        String?      @map("document_id")
  address           String?
  notes             String?
  tags              String[]     @default([])
  source            String       @default("whatsapp")
  lastContactAt     DateTime?    @map("last_contact_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders        Order[]
  conversations Conversation[]
  reservations  Reservation[]

  @@unique([tenantId, phone])
  @@unique([tenantId, waUserId])
  @@index([tenantId, createdAt])
  @@map("customers")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderChannel {
  WHATSAPP
  MANUAL
}

model Order {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  /// Correlativo por empresa
  number          Int
  customerId      String       @map("customer_id") @db.Uuid
  branchId        String       @map("branch_id") @db.Uuid
  conversationId  String?      @map("conversation_id") @db.Uuid
  status          OrderStatus  @default(PENDING)
  channel         OrderChannel
  currency        String       @db.Char(3)
  subtotal        Decimal      @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  notes           String?
  deliveryAddress String?      @map("delivery_address")
  /// Clave de idempotencia (p. ej. hash de conversación + carrito confirmado)
  idempotencyKey  String?      @map("idempotency_key")
  createdById     String?      @map("created_by_id") @db.Uuid
  confirmedAt     DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      Customer             @relation(fields: [customerId], references: [id])
  conversation  Conversation?        @relation(fields: [conversationId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  movements     InventoryMovement[]

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
