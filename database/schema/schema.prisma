// =============================================================================
// AI Sales Assistant - esquema de datos (PostgreSQL 17, Prisma 7)
//
// Multiempresa: toda tabla de negocio lleva tenant_id. Las políticas RLS se
// definen en las migraciones SQL (database/migrations/*/migration.sql) y se
// aplican al rol de ejecución (sin BYPASSRLS). Convención: modelos en
// PascalCase, tablas/columnas en snake_case.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------- Planes / SaaS

enum PlanCode {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Plan {
  id            String         @id @default(uuid(7)) @db.Uuid
  code          PlanCode       @unique
  name          String
  priceMonthly  Decimal        @map("price_monthly") @db.Decimal(12, 2)
  currency      String         @default("USD") @db.Char(3)
  /// Límites y funciones: { maxUsers, maxWhatsappNumbers, maxConversationsPerMonth, maxProducts, maxBranches, features: string[] }
  limits        Json
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String
  slug         String       @unique
  status       TenantStatus @default(ACTIVE)
  currency     String       @default("PEN") @db.Char(3)
  timezone     String       @default("America/Lima")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription Subscription?
  users        User[]
  branches     Branch[]

  @@map("tenants")
}

model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @unique @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(3)
  /// Proveedor de pagos (null hasta configurar uno; no hay cobros reales)
  paymentProvider    String?            @map("payment_provider")
  paymentProviderRef String?            @map("payment_provider_ref")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model UsageCounter {
  tenantId String @map("tenant_id") @db.Uuid
  metric   String
  /// Periodo YYYY-MM
  period   String @db.Char(7)
  value    Int    @default(0)

  @@id([tenantId, metric, period])
  @@map("usage_counters")
}

/// Contadores por empresa (p. ej. numeración de pedidos), incrementados en transacción
model TenantCounter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
  @@map("tenant_counters")
}

// ----------------------------------------------------------------- Usuarios / auth

enum Role {
  PLATFORM_ADMIN
  TENANT_ADMIN
  SUPERVISOR
  SELLER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// null solo para PLATFORM_ADMIN
  tenantId         String?    @map("tenant_id") @db.Uuid
  /// Siempre en minúsculas; único en toda la plataforma
  email            String     @unique
  name             String
  passwordHash     String?    @map("password_hash")
  role             Role
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions   Session[]
  authTokens AuthToken[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  /// SHA-256 del refresh token (el token en claro nunca se guarda)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// Todas las rotaciones de un mismo inicio de sesión comparten familia
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ----------------------------------------------------------------- Catálogo

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]
  movements   InventoryMovement[]

  @@unique([tenantId, name])
  @@map("branches")
}

model Category {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  parentId    String?    @map("parent_id") @db.Uuid
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  sku         String
  barcode     String?
  name        String
  description String?
  salePrice   Decimal       @map("sale_price") @db.Decimal(12, 2)
  costPrice   Decimal?      @map("cost_price") @db.Decimal(12, 2)
  minStock    Int           @default(0) @map("min_stock")
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]
  history  ProductHistory[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@map("products")
}

/// Todo producto tiene al menos una variante (la predeterminada). El stock vive en la variante.
model ProductVariant {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String
  barcode    String?
  /// Nombre legible, p. ej. "Talla 42 / Negro"
  name       String
  /// Atributos, p. ej. { "talla": "42", "color": "negro" }
  attributes Json     @default("{}")
  /// Si es null se usa el precio del producto
  salePrice  Decimal? @map("sale_price") @db.Decimal(12, 2)
  costPrice  Decimal? @map("cost_price") @db.Decimal(12, 2)
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]
  movements   InventoryMovement[]
  orderItems  OrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  storageKey String   @map("storage_key")
  url        String
  alt        String?
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  /// { campo: { from, to } }
  changes   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_history")
}

// ----------------------------------------------------------------- Inventario

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  RETURN_IN
  TRANSFER_IN
  TRANSFER_OUT
  SALE_VOID
}

model StockLevel {
  tenantId  String   @map("tenant_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([variantId, branchId])
  @@index([tenantId])
  @@map("stock_levels")
}

/// Libro de movimientos: inmutable. stock_after = stock_before + quantity.
model InventoryMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  variantId      String       @map("variant_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  type           MovementType
  /// Con signo: positivo entra, negativo sale
  quantity       Int
  stockBefore    Int          @map("stock_before")
  stockAfter     Int          @map("stock_after")
  reason         String?
  orderId        String?      @map("order_id") @db.Uuid
  /// Evita aplicar dos veces el mismo movimiento (p. ej. order:<id>:sale:<variant>)
  idempotencyKey String?      @map("idempotency_key")
  /// Movimiento autorizado explícitamente a dejar stock negativo
  allowNegative  Boolean      @default(false) @map("allow_negative")
  userId         String?      @map("user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id])
  branch  Branch         @relation(fields: [branchId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ----------------------------------------------------------------- Clientes / pedidos

model Customer {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String?
  /// E.164 sin "+", tal como lo entrega WhatsApp (p. ej. 51987654321)
  phone         String
  email         String?
  documentId    String?   @map("document_id")
  address       String?
  notes         String?
  tags          String[]  @default([])
  source        String    @default("whatsapp")
  lastContactAt DateTime? @map("last_contact_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders        Order[]
  conversations Conversation[]

  @@unique([tenantId, phone])
  @@index([tenantId, createdAt])
  @@map("customers")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderChannel {
  WHATSAPP
  MANUAL
}

model Order {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  /// Correlativo por empresa
  number          Int
  customerId      String       @map("customer_id") @db.Uuid
  branchId        String       @map("branch_id") @db.Uuid
  conversationId  String?      @map("conversation_id") @db.Uuid
  status          OrderStatus  @default(PENDING)
  channel         OrderChannel
  currency        String       @db.Char(3)
  subtotal        Decimal      @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  notes           String?
  deliveryAddress String?      @map("delivery_address")
  /// Clave de idempotencia (p. ej. hash de conversación + carrito confirmado)
  idempotencyKey  String?      @map("idempotency_key")
  createdById     String?      @map("created_by_id") @db.Uuid
  confirmedAt     DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      Customer             @relation(fields: [customerId], references: [id])
  conversation  Conversation?        @relation(fields: [conversationId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  movements     InventoryMovement[]

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  /// Copias en el momento de la venta (no cambian si se edita el producto)
  productName String  @map("product_name")
  variantName String  @map("variant_name")
  sku         String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([tenantId, variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  userId     String?      @map("user_id") @db.Uuid
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ----------------------------------------------------------------- WhatsApp / conversaciones

enum WhatsappProvider {
  CLOUD_API
  EVOLUTION
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

model WhatsappNumber {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  provider          WhatsappProvider
  displayPhone      String           @map("display_phone")
  /// Cloud API: phone_number_id (enruta webhooks a la empresa). Único global.
  phoneNumberId     String?          @unique @map("phone_number_id")
  wabaId            String?          @map("waba_id")
  /// Evolution: nombre de instancia. Único global.
  evolutionInstance String?          @unique @map("evolution_instance")
  /// Token de acceso cifrado (AES-256-GCM) con la clave maestra del servidor
  accessTokenEnc    String?          @map("access_token_enc")
  status            ConnectionStatus @default(PENDING)
  lastError         String?          @map("last_error")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversations Conversation[]

  @@index([tenantId])
  @@map("whatsapp_numbers")
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

enum BotStatus {
  ACTIVE
  PAUSED
}

model Conversation {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  customerId             String             @map("customer_id") @db.Uuid
  whatsappNumberId       String             @map("whatsapp_number_id") @db.Uuid
  status                 ConversationStatus @default(OPEN)
  botStatus              BotStatus          @default(ACTIVE) @map("bot_status")
  handoffReason          String?            @map("handoff_reason")
  handoffAt              DateTime?          @map("handoff_at") @db.Timestamptz(3)
  assignedUserId         String?            @map("assigned_user_id") @db.Uuid
  chatwootConversationId Int?               @map("chatwoot_conversation_id")
  difyConversationId     String?            @map("dify_conversation_id")
  /// Memoria de la conversación: productos consultados, carrito, etc.
  context                Json               @default("{}")
  lastMessageAt          DateTime?          @map("last_message_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer       Customer       @relation(fields: [customerId], references: [id])
  whatsappNumber WhatsappNumber @relation(fields: [whatsappNumberId], references: [id])
  messages       Message[]
  orders         Order[]

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, customerId])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SenderType {
  CUSTOMER
  BOT
  AGENT
  SYSTEM
}

model Message {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  direction         MessageDirection
  senderType        SenderType       @map("sender_type")
  senderUserId      String?          @map("sender_user_id") @db.Uuid
  type              String           @default("text")
  content           String
  /// wamid u otro id del proveedor
  providerMessageId String?          @map("provider_message_id")
  status            String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

enum EventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Registro de webhooks entrantes. Tabla de SISTEMA: sin acceso para el rol de ejecución.
model InboundEvent {
  id          String      @id @default(uuid(7)) @db.Uuid
  provider    String
  /// Id único del proveedor (wamid, id de evento de Chatwoot...)
  externalId  String      @map("external_id")
  tenantId    String?     @map("tenant_id") @db.Uuid
  payload     Json
  status      EventStatus @default(RECEIVED)
  attempts    Int         @default(0)
  error       String?
  receivedAt  DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?   @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([status, receivedAt])
  @@map("inbound_events")
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
}

model OutboundMessage {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  conversationId    String         @map("conversation_id") @db.Uuid
  idempotencyKey    String         @map("idempotency_key")
  payload           Json
  status            OutboundStatus @default(QUEUED)
  attempts          Int            @default(0)
  providerMessageId String?        @map("provider_message_id")
  error             String?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)

  @@unique([tenantId, idempotencyKey])
  @@index([status, createdAt])
  @@map("outbound_messages")
}

// ----------------------------------------------------------------- Configuración

model AiSettings {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  isEnabled        Boolean  @default(true) @map("is_enabled")
  assistantName    String   @default("Asistente") @map("assistant_name")
  tone             String   @default("amable y profesional")
  welcomeMessage   String?  @map("welcome_message")
  /// Información del negocio (horarios, envíos, pagos). Nunca precios ni stock.
  businessInfo     String?  @map("business_info")
  handoffKeywords  String[] @default(["humano", "asesor", "persona", "reclamo", "queja"]) @map("handoff_keywords")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_settings")
}

enum AutomationKey {
  LOW_STOCK_ALERT
  NEW_ORDER_NOTIFICATION
  ORDER_STATUS_NOTIFICATION
  HANDOFF_NOTIFICATION
  ERROR_ALERT
}

/// Flujos predefinidos que la empresa activa/configura (nunca edita: licencia n8n)
model Automation {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  key       AutomationKey
  isEnabled Boolean       @default(true) @map("is_enabled")
  config    Json          @default("{}")
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, key])
  @@map("automations")
}

enum IntegrationType {
  CHATWOOT
  DIFY
  N8N
}

model TenantIntegration {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  type       IntegrationType
  /// Configuración no secreta (ids de cuenta/inbox, etc.)
  config     Json             @default("{}")
  /// Secretos cifrados (AES-256-GCM)
  secretsEnc String?          @map("secrets_enc")
  status     ConnectionStatus @default(PENDING)
  lastError  String?          @map("last_error")
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, type])
  @@map("tenant_integrations")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  /// null = para todos los administradores de la empresa
  userId    String?   @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// null = acción de plataforma
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
