// ----------------------------------------------------------------- Centro universal de APIs (ADR 046)

enum CredentialStatus {
  CONNECTED
  CONNECTED_WITH_WARNINGS
  AUTH_ERROR
  PERMISSION_DENIED
  UNAVAILABLE
  INCOMPLETE
  PENDING_AUTHORIZATION
  DISABLED
}

enum AiService {
  /// Asistente que atiende a los clientes de la empresa
  ASSISTANT
  /// Agente comercial de la plataforma (nuestro negocio)
  COMMERCIAL
}

enum CredentialMode {
  /// Credencial de la plataforma asignada a la empresa
  MANAGED
  /// Clave propia de la empresa
  OWN
}

enum AiProfile {
  ECONOMY
  ADVANCED
  CUSTOM
}

/// Bóveda de credenciales. tenantId null = administrada por la plataforma (solo rol de sistema)
model ProviderCredential {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String?          @map("tenant_id") @db.Uuid
  provider          String
  label             String
  /// Campos no secretos (región, endpoint, id de proyecto…)
  config            Json             @default("{}")
  /// JSON de los campos secretos, cifrado (AES-256-GCM)
  secretsEnc        String           @map("secrets_enc")
  /// Últimos caracteres, para reconocerla sin mostrarla
  secretHint        String           @map("secret_hint")
  status            CredentialStatus @default(INCOMPLETE)
  lastError         String?          @map("last_error")
  lastCheckedAt     DateTime?        @map("last_checked_at") @db.Timestamptz(3)
  connectedAt       DateTime?        @map("connected_at") @db.Timestamptz(3)
  rotatedAt         DateTime?        @map("rotated_at") @db.Timestamptz(3)
  disabledAt        DateTime?        @map("disabled_at") @db.Timestamptz(3)
  /// Tope mensual de tokens de la credencial (todas las empresas que la usan)
  monthlyTokenLimit Int?             @map("monthly_token_limit")
  createdById       String?          @map("created_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments         AiAssignment[] @relation("primary")
  fallbackAssignments AiAssignment[] @relation("fallback")

  @@index([tenantId, provider])
  @@map("provider_credentials")
}

/// Catálogo de modelos (leído del proveedor o añadido a mano). Solo la plataforma
model AiModel {
  id                 String    @id @default(uuid(7)) @db.Uuid
  provider           String
  modelId            String    @map("model_id")
  displayName        String?   @map("display_name")
  /// PROVIDER | MANUAL
  source             String
  contextWindow      Int?      @map("context_window")
  maxOutputTokens    Int?      @map("max_output_tokens")
  inputPricePerMTok  Decimal?  @map("input_price_per_mtok") @db.Decimal(12, 4)
  outputPricePerMTok Decimal?  @map("output_price_per_mtok") @db.Decimal(12, 4)
  priceCurrency      String    @default("USD") @map("price_currency") @db.Char(3)
  isEnabled          Boolean   @default(true) @map("is_enabled")
  lastSeenAt         DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, modelId])
  @@map("ai_models")
}

model AiAssignment {
  id                         String         @id @default(uuid(7)) @db.Uuid
  tenantId                   String         @map("tenant_id") @db.Uuid
  service                    AiService
  provider                   String
  credentialId               String         @map("credential_id") @db.Uuid
  mode                       CredentialMode
  /// null solo en Gemini migrado = modelo del servidor (GEMINI_MODEL)
  model                      String?
  profile                    AiProfile      @default(ECONOMY)
  /// { maxOutputTokens?, temperature?, effort? } (ai/providers/params.ts)
  params                     Json           @default("{}")
  monthlyTokenLimit          Int?           @map("monthly_token_limit")
  fallbackCredentialId       String?        @map("fallback_credential_id") @db.Uuid
  fallbackModel              String?        @map("fallback_model")
  /// Autorización explícita para que el respaldo use otro proveedor
  allowCrossProviderFallback Boolean        @default(false) @map("allow_cross_provider_fallback")
  isActive                   Boolean        @default(true) @map("is_active")
  assignedById               String?        @map("assigned_by_id") @db.Uuid
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential         ProviderCredential  @relation("primary", fields: [credentialId], references: [id], onDelete: Restrict)
  fallbackCredential ProviderCredential? @relation("fallback", fields: [fallbackCredentialId], references: [id], onDelete: SetNull)

  @@unique([tenantId, service])
  @@index([credentialId])
  @@map("ai_assignments")
}

/// Consumo por llamada al modelo (sin contenido de la conversación)
model AiUsageEvent {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  assignmentId String?   @map("assignment_id") @db.Uuid
  service      AiService
  provider     String
  model        String
  /// null = clave del servidor (GEMINI_API_KEY)
  credentialId String?   @map("credential_id") @db.Uuid
  /// MANAGED | OWN | SERVER
  mode         String
  inputTokens  Int       @default(0) @map("input_tokens")
  outputTokens Int       @default(0) @map("output_tokens")
  /// null = el modelo no tiene precio configurado (no se inventa)
  cost         Decimal?  @db.Decimal(14, 6)
  costCurrency String?   @map("cost_currency") @db.Char(3)
  ok           Boolean
  error        String?
  latencyMs    Int?      @map("latency_ms")
  fallbackUsed Boolean   @default(false) @map("fallback_used")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([credentialId, createdAt])
  @@map("ai_usage_events")
}

// ----------------------------------------------------------------- Centro comercial (ADR 047)

/// Etapas del embudo. PAYMENT_CONFIRMED solo con validación administrativa del
/// pago; INSTALLATION_PENDING y ACTIVE_CLIENT solo por la conversión y la
/// activación de la empresa (no se mueven a mano).
enum SalesLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_REQUESTED
  QUOTE_SENT
  NEGOTIATION
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  INSTALLATION_PENDING
  ACTIVE_CLIENT
  LOST
}

enum SalesLeadSource {
  WEBSITE
  WHATSAPP
  REFERRAL
  SOCIAL
  EVENT
  OUTBOUND
  OTHER
}

enum SalesActivityType {
  CREATED
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  UPDATED
  STATUS_CHANGED
  OWNER_CHANGED
  NEXT_ACTION_SET
  NEXT_ACTION_DONE
  PAYMENT_VALIDATED
  CONVERTED
  ACTIVATED
}

/// Prospecto de AI Sales Assistant (nuestro negocio, no el de las empresas).
/// Solo el rol de sistema accede (RLS sin políticas y sin permisos de ejecución).
model SalesLead {
  id                    String          @id @default(uuid(7)) @db.Uuid
  number                Int             @unique @default(autoincrement())
  name                  String
  company               String?
  phone                 String?
  email                 String?
  /// Plantilla del sector (templates/catalog.ts) u «other»
  sector                String?
  need                  String?
  source                SalesLeadSource
  sourceDetail          String?         @map("source_detail")
  estimatedBudget       Decimal?        @map("estimated_budget") @db.Decimal(12, 2)
  budgetCurrency        String          @default("PEN") @map("budget_currency") @db.Char(3)
  interestMode          DeploymentMode? @map("interest_mode")
  interestPlan          String?         @map("interest_plan")
  interestModules       String[]        @default([]) @map("interest_modules")
  status                SalesLeadStatus @default(NEW)
  ownerId               String?         @map("owner_id") @db.Uuid
  nextAction            String?         @map("next_action")
  nextActionAt          DateTime?       @map("next_action_at") @db.Timestamptz(3)
  lostReason            String?         @map("lost_reason")
  /// Aceptó que lo contactemos después (formulario o chat), con cuándo y dónde
  followUpConsent       Boolean         @default(false) @map("follow_up_consent")
  followUpConsentAt     DateTime?       @map("follow_up_consent_at") @db.Timestamptz(3)
  followUpConsentSource String?         @map("follow_up_consent_source")
  /// Empresa creada al convertir el prospecto en cliente
  tenantId              String?         @unique @map("tenant_id") @db.Uuid
  convertedAt           DateTime?       @map("converted_at") @db.Timestamptz(3)
  statusChangedAt       DateTime        @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  createdById           String?         @map("created_by_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner         User?               @relation("leadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  activities    SalesActivity[]
  chats         SalesChatSession[]
  quotes        SalesQuote[]
  paymentOrders SalesPaymentOrder[]
  accounting    AccountingEntry[]
  installations InstallationOrder[]

  @@index([status, updatedAt])
  @@index([ownerId])
  @@index([nextActionAt])
  @@map("sales_leads")
}

/// Historial del prospecto: solo se anexa (un disparador impide cambiarlo o borrarlo)
model SalesActivity {
  id        String            @id @default(uuid(7)) @db.Uuid
  leadId    String            @map("lead_id") @db.Uuid
  type      SalesActivityType
  body      String?
  metadata  Json              @default("{}")
  userId    String?           @map("user_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  lead SalesLead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@map("sales_activities")
}

// ----------------------------------------------------------------- Página y agente comercial (ADR 048)

/// Configuración de la página comercial y del agente (una sola fila, id = 1)
model CommercialSettings {
  id                Int       @id @default(1)
  published         Boolean   @default(false)
  headline          String?
  subheadline       String?
  /// [{ title, text }]
  problems          Json      @default("[]")
  /// [{ title, text }]
  benefits          Json      @default("[]")
  /// [{ q, a }]
  faqs              Json      @default("[]")
  /// [{ name, company, quote, authorizedAt }]: solo testimonios reales con autorización
  testimonials      Json      @default("[]")
  contactEmail      String?   @map("contact_email")
  contactWhatsapp   String?   @map("contact_whatsapp")
  showPrices        Boolean   @default(false) @map("show_prices")
  chatEnabled       Boolean   @default(false) @map("chat_enabled")
  agentName         String?   @map("agent_name")
  agentInstructions String?   @map("agent_instructions")
  houseTenantId     String?   @map("house_tenant_id") @db.Uuid
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(3)
  /// Emisor e impuestos de las cotizaciones (ADR 049)
  legalName         String?   @map("legal_name")
  taxId             String?   @map("tax_id")
  address           String?
  taxName           String?   @map("tax_name")
  taxRate           Decimal?  @map("tax_rate") @db.Decimal(5, 2)
  pricesIncludeTax  Boolean   @default(false) @map("prices_include_tax")
  quoteValidityDays Int       @default(15) @map("quote_validity_days")
  quoteTerms        String?   @map("quote_terms")
  updatedById       String?   @map("updated_by_id") @db.Uuid
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  houseTenant Tenant? @relation(fields: [houseTenantId], references: [id], onDelete: SetNull)

  @@map("commercial_settings")
}

enum SalesChatRole {
  VISITOR
  AGENT
}

model SalesChatSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  tokenHash     String    @map("token_hash") @db.Char(64)
  leadId        String?   @map("lead_id") @db.Uuid
  messageCount  Int       @default(0) @map("message_count")
  handoffReason String?   @map("handoff_reason")
  handoffAt     DateTime? @map("handoff_at") @db.Timestamptz(3)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  lead     SalesLead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages SalesChatMessage[]

  @@index([leadId])
  @@map("sales_chat_sessions")
}

model SalesChatMessage {
  id        String        @id @default(uuid(7)) @db.Uuid
  sessionId String        @map("session_id") @db.Uuid
  role      SalesChatRole
  text      String
  tools     String[]      @default([])
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  session SalesChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("sales_chat_messages")
}

// ----------------------------------------------------------------- Cotizaciones, contratación y pagos (ADR 049)

enum CatalogItemKind {
  PLAN
  USERS
  MODULE
  SETUP
  SERVER
  INTEGRATION
  SERVICE
  SUPPORT
  MAINTENANCE
  OTHER
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InitialPayment {
  ONE_TIME
  ONE_TIME_AND_FIRST_MONTH
}

enum PaymentOrderStatus {
  PENDING
  PROOF_SUBMITTED
  PAID
  CANCELLED
}

enum InstallationOrderStatus {
  AUTHORIZED
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Catálogo comercial con precios: lo que se cotiza (lo edita la plataforma)
model CommercialItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  code        String          @unique
  name        String
  description String?
  kind        CatalogItemKind
  billing     BillingCycle
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  currency    String          @db.Char(3)
  unit        String?
  planCode    PlanCode?       @map("plan_code")
  module      String?
  isActive    Boolean         @default(true) @map("is_active")
  sort        Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines SalesQuoteLine[]

  @@map("commercial_items")
}

/// Versiones del contrato: solo se agregan
model ContractVersion {
  id          String   @id @default(uuid(7)) @db.Uuid
  version     Int      @unique
  title       String
  body        String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  quotes SalesQuote[]

  @@map("contract_versions")
}

model SalesQuote {
  id                String          @id @default(uuid(7)) @db.Uuid
  number            Int             @unique @default(autoincrement())
  leadId            String          @map("lead_id") @db.Uuid
  status            QuoteStatus     @default(DRAFT)
  currency          String          @db.Char(3)
  country           String?         @db.Char(2)
  planCode          PlanCode?       @map("plan_code")
  users             Int?
  modules           String[]        @default([])
  deploymentMode    DeploymentMode? @map("deployment_mode")
  serverResources   String?         @map("server_resources")
  initialSetup      String?         @map("initial_setup")
  integrations      String?
  support           String?
  maintenance       String?
  notes             String?
  initialPayment    InitialPayment  @default(ONE_TIME_AND_FIRST_MONTH) @map("initial_payment")
  subtotalOneTime   Decimal         @default(0) @map("subtotal_one_time") @db.Decimal(12, 2)
  subtotalMonthly   Decimal         @default(0) @map("subtotal_monthly") @db.Decimal(12, 2)
  taxName           String?         @map("tax_name")
  taxRate           Decimal?        @map("tax_rate") @db.Decimal(5, 2)
  pricesIncludeTax  Boolean         @default(false) @map("prices_include_tax")
  taxOneTime        Decimal         @default(0) @map("tax_one_time") @db.Decimal(12, 2)
  taxMonthly        Decimal         @default(0) @map("tax_monthly") @db.Decimal(12, 2)
  totalOneTime      Decimal         @default(0) @map("total_one_time") @db.Decimal(12, 2)
  totalMonthly      Decimal         @default(0) @map("total_monthly") @db.Decimal(12, 2)
  terms             String?
  validUntil        DateTime?       @map("valid_until") @db.Date
  contractVersionId String?         @map("contract_version_id") @db.Uuid
  /// Emisor y cliente tal como quedaron al enviar
  issuer            Json?
  client            Json?
  accessTokenHash   String?         @map("access_token_hash") @db.Char(64)
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(3)
  sentById          String?         @map("sent_by_id") @db.Uuid
  acceptedAt        DateTime?       @map("accepted_at") @db.Timestamptz(3)
  acceptedName      String?         @map("accepted_name")
  acceptedDocument  String?         @map("accepted_document")
  acceptedEmail     String?         @map("accepted_email")
  acceptedIp        String?         @map("accepted_ip")
  acceptedUserAgent String?         @map("accepted_user_agent")
  rejectedAt        DateTime?       @map("rejected_at") @db.Timestamptz(3)
  rejectionReason   String?         @map("rejection_reason")
  closedAt          DateTime?       @map("closed_at") @db.Timestamptz(3)
  createdById       String?         @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead            SalesLead           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  contractVersion ContractVersion?    @relation(fields: [contractVersionId], references: [id], onDelete: Restrict)
  lines           SalesQuoteLine[]
  paymentOrders   SalesPaymentOrder[]
  installations   InstallationOrder[]

  @@index([leadId])
  @@index([status])
  @@map("sales_quotes")
}

model SalesQuoteLine {
  id          String          @id @default(uuid(7)) @db.Uuid
  quoteId     String          @map("quote_id") @db.Uuid
  position    Int
  itemId      String?         @map("item_id") @db.Uuid
  kind        CatalogItemKind
  billing     BillingCycle
  description String
  quantity    Decimal         @db.Decimal(10, 2)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  total       Decimal         @db.Decimal(12, 2)

  quote SalesQuote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  item  CommercialItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("sales_quote_lines")
}

/// Métodos de pago por país y moneda (instrucciones escritas por la plataforma)
model PaymentMethodConfig {
  id           String        @id @default(uuid(7)) @db.Uuid
  kind         PaymentMethod
  name         String
  instructions String
  countries    String[]      @default([])
  currencies   String[]      @default([])
  isActive     Boolean       @default(true) @map("is_active")
  sort         Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payment_methods")
}

model SalesPaymentOrder {
  id               String             @id @default(uuid(7)) @db.Uuid
  number           Int                @unique @default(autoincrement())
  leadId           String             @map("lead_id") @db.Uuid
  quoteId          String?            @map("quote_id") @db.Uuid
  concept          String
  amount           Decimal            @db.Decimal(12, 2)
  currency         String             @db.Char(3)
  country          String?            @db.Char(2)
  status           PaymentOrderStatus @default(PENDING)
  allowedMethodIds String[]           @default([]) @map("allowed_method_ids") @db.Uuid
  accessTokenHash  String?            @map("access_token_hash") @db.Char(64)
  /// Comprobante declarado por el cliente: { methodId, reference, payer, paidAt, amount, note }
  proof            Json?
  proofSubmittedAt DateTime?          @map("proof_submitted_at") @db.Timestamptz(3)
  paidAt           DateTime?          @map("paid_at") @db.Timestamptz(3)
  method           PaymentMethod?
  reference        String?
  validatedById    String?            @map("validated_by_id") @db.Uuid
  validatedAt      DateTime?          @map("validated_at") @db.Timestamptz(3)
  gatewayProvider  String?            @map("gateway_provider")
  gatewayPaymentId String?            @map("gateway_payment_id")
  cancelReason     String?            @map("cancel_reason")
  createdById      String?            @map("created_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead         SalesLead           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  quote        SalesQuote?         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  events       SalesPaymentEvent[]
  accounting   AccountingEntry?
  installation InstallationOrder?

  @@unique([gatewayProvider, gatewayPaymentId])
  @@index([leadId])
  @@index([status])
  @@map("sales_payment_orders")
}

/// Historial de la orden de pago: solo se agrega
model SalesPaymentEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  type      String
  data      Json     @default("{}")
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order SalesPaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("sales_payment_events")
}

/// Eventos de pasarela ya procesados (idempotencia)
model PaymentGatewayEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  provider  String
  eventId   String   @map("event_id")
  orderId   String?  @map("order_id") @db.Uuid
  outcome   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("payment_gateway_events")
}

/// Libro de ingresos: solo se agregan asientos
model AccountingEntry {
  id             String         @id @default(uuid(7)) @db.Uuid
  number         Int            @unique @default(autoincrement())
  entryDate      DateTime       @map("entry_date") @db.Date
  kind           String
  leadId         String?        @map("lead_id") @db.Uuid
  paymentOrderId String         @unique @map("payment_order_id") @db.Uuid
  description    String
  currency       String         @db.Char(3)
  gross          Decimal        @db.Decimal(12, 2)
  tax            Decimal        @db.Decimal(12, 2)
  net            Decimal        @db.Decimal(12, 2)
  method         PaymentMethod?
  reference      String?
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  lead         SalesLead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  paymentOrder SalesPaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@map("accounting_entries")
}

/// Orden de instalación: nace solo de un pago validado
model InstallationOrder {
  id              String                  @id @default(uuid(7)) @db.Uuid
  number          Int                     @unique @default(autoincrement())
  leadId          String                  @map("lead_id") @db.Uuid
  quoteId         String?                 @map("quote_id") @db.Uuid
  paymentOrderId  String                  @unique @map("payment_order_id") @db.Uuid
  status          InstallationOrderStatus @default(AUTHORIZED)
  deploymentMode  DeploymentMode?         @map("deployment_mode")
  planCode        PlanCode?               @map("plan_code")
  users           Int?
  modules         String[]                @default([])
  serverResources String?                 @map("server_resources")
  notes           String?
  tenantId        String?                 @map("tenant_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead             SalesLead            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  quote            SalesQuote?          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  paymentOrder     SalesPaymentOrder    @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  tenant           Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  serverRequests   InfraServerRequest[]
  servers          InfraServer[]
  provisioningRuns ProvisioningRun[]

  @@index([leadId])
  @@map("installation_orders")
}

// ---------------------------------------------------------------- Infraestructura (ADR 050)

enum InfraKind {
  HETZNER
}

enum ServerRequestStatus {
  PENDING_APPROVAL
  REJECTED
  CANCELLED
  CREATING
  CREATED
  FAILED
}

/// Proveedor de servidores con token cifrado, límites y presupuesto
model InfraProvider {
  id                 String           @id @default(uuid(7)) @db.Uuid
  kind               InfraKind
  label              String
  secretsEnc         String           @map("secrets_enc")
  secretHint         String           @map("secret_hint")
  status             CredentialStatus @default(INCOMPLETE)
  lastError          String?          @map("last_error")
  lastCheckedAt      DateTime?        @map("last_checked_at") @db.Timestamptz(3)
  connectedAt        DateTime?        @map("connected_at") @db.Timestamptz(3)
  rotatedAt          DateTime?        @map("rotated_at") @db.Timestamptz(3)
  disabledAt         DateTime?        @map("disabled_at") @db.Timestamptz(3)
  currency           String?          @db.Char(3)
  monthlyBudget      Decimal?         @map("monthly_budget") @db.Decimal(12, 2)
  maxServers         Int?             @map("max_servers")
  allowedLocations   String[]         @default([]) @map("allowed_locations")
  allowedServerTypes String[]         @default([]) @map("allowed_server_types")
  defaultImage       String           @default("ubuntu-24.04") @map("default_image")
  sshSourceCidrs     String[]         @default([]) @map("ssh_source_cidrs")
  createdById        String?          @map("created_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  requests   InfraServerRequest[]
  servers    InfraServer[]
  operations InfraOperation[]

  provisioningRuns ProvisioningRun[]

  @@map("infra_providers")
}

/// Claves SSH públicas que se instalan en los servidores creados
model InfraSshKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  publicKey   String   @map("public_key")
  fingerprint String   @unique
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("infra_ssh_keys")
}

/// Solicitud de servidor: nada se crea sin aprobación dentro del presupuesto
model InfraServerRequest {
  id                  String              @id @default(uuid(7)) @db.Uuid
  number              Int                 @unique @default(autoincrement())
  providerId          String              @map("provider_id") @db.Uuid
  installationOrderId String?             @map("installation_order_id") @db.Uuid
  purpose             String
  name                String
  serverType          String              @map("server_type")
  location            String
  image               String
  priceHourly         Decimal             @map("price_hourly") @db.Decimal(12, 4)
  priceMonthly        Decimal             @map("price_monthly") @db.Decimal(12, 4)
  currency            String              @db.Char(3)
  status              ServerRequestStatus @default(PENDING_APPROVAL)
  requestedById       String?             @map("requested_by_id") @db.Uuid
  decidedById         String?             @map("decided_by_id") @db.Uuid
  decidedAt           DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNote        String?             @map("decision_note")
  error               String?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider          InfraProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  installationOrder InstallationOrder? @relation(fields: [installationOrderId], references: [id], onDelete: Restrict)
  server            InfraServer?
  operations        InfraOperation[]

  provisioningRuns ProvisioningRun[]

  @@index([status])
  @@map("infra_server_requests")
}

model InfraServer {
  id                  String    @id @default(uuid(7)) @db.Uuid
  providerId          String    @map("provider_id") @db.Uuid
  requestId           String?   @unique @map("request_id") @db.Uuid
  externalId          String    @map("external_id")
  name                String
  status              String
  serverType          String    @map("server_type")
  location            String
  image               String?
  ipv4                String?
  ipv6                String?
  firewallExternalId  String?   @map("firewall_external_id")
  priceHourly         Decimal?  @map("price_hourly") @db.Decimal(12, 4)
  priceMonthly        Decimal?  @map("price_monthly") @db.Decimal(12, 4)
  currency            String?   @db.Char(3)
  installationOrderId String?   @map("installation_order_id") @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
  imported            Boolean   @default(false)
  providerCreatedAt   DateTime  @map("provider_created_at") @db.Timestamptz(3)
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById         String?   @map("deleted_by_id") @db.Uuid
  deleteReason        String?   @map("delete_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider          InfraProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  request           InfraServerRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  installationOrder InstallationOrder?  @relation(fields: [installationOrderId], references: [id], onDelete: Restrict)
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operations        InfraOperation[]

  provisioningRuns ProvisioningRun[]

  @@unique([providerId, externalId])
  @@map("infra_servers")
}

/// Registro de operaciones contra el proveedor: solo se agrega
model InfraOperation {
  id         String   @id @default(uuid(7)) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  serverId   String?  @map("server_id") @db.Uuid
  requestId  String?  @map("request_id") @db.Uuid
  kind       String
  ok         Boolean
  detail     Json     @default("{}")
  userId     String?  @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider InfraProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  server   InfraServer?        @relation(fields: [serverId], references: [id], onDelete: Restrict)
  request  InfraServerRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([providerId, createdAt])
  @@index([serverId])
  @@map("infra_operations")
}

// ---------------------------------------------------------------- Orquestador de aprovisionamiento (ADR 051)

enum ProvisioningStatus {
  REQUESTED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PREPARING
  CREATING_INFRA
  SERVER_READY
  CONFIGURING_SERVER
  INSTALLING
  MIGRATING
  CONFIGURING_INTEGRATIONS
  TESTING
  PUBLISHING
  DELIVERING
  DELIVERED
  ERROR
  CANCELLED
  NEEDS_INTERVENTION
}

/// Una instalación administrada de principio a fin (solo rol de sistema)
model ProvisioningRun {
  id                  String              @id @default(uuid(7)) @db.Uuid
  number              Int                 @unique @default(autoincrement())
  installationOrderId String              @map("installation_order_id") @db.Uuid
  providerId          String              @map("provider_id") @db.Uuid
  serverType          String              @map("server_type")
  location            String
  domain              String
  adminEmail          String              @map("admin_email")
  settings            Json                @default("{}")
  secretsEnc          String?             @map("secrets_enc")
  status              ProvisioningStatus  @default(REQUESTED)
  stoppedAt           ProvisioningStatus? @map("stopped_at")
  attempts            Int                 @default(0)
  nextRunAt           DateTime?           @map("next_run_at") @db.Timestamptz(3)
  stepStartedAt       DateTime            @default(now()) @map("step_started_at") @db.Timestamptz(3)
  stepDeadlineAt      DateTime?           @map("step_deadline_at") @db.Timestamptz(3)
  leaseUntil          DateTime?           @map("lease_until") @db.Timestamptz(3)
  lastError           String?             @map("last_error")
  needs               String?
  serverRequestId     String?             @map("server_request_id") @db.Uuid
  serverId            String?             @map("server_id") @db.Uuid
  bootstrapHash       String?             @map("bootstrap_hash")
  bootstrapExpiresAt  DateTime?           @map("bootstrap_expires_at") @db.Timestamptz(3)
  bootstrapUsedAt     DateTime?           @map("bootstrap_used_at") @db.Timestamptz(3)
  agentHash           String?             @map("agent_hash")
  agentSeenAt         DateTime?           @map("agent_seen_at") @db.Timestamptz(3)
  alertedAt           DateTime?           @map("alerted_at") @db.Timestamptz(3)
  cancelReason        String?             @map("cancel_reason")
  createdById         String              @map("created_by_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt          DateTime?           @map("finished_at") @db.Timestamptz(3)

  installationOrder InstallationOrder   @relation(fields: [installationOrderId], references: [id], onDelete: Restrict)
  provider          InfraProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  serverRequest     InfraServerRequest? @relation(fields: [serverRequestId], references: [id], onDelete: Restrict)
  server            InfraServer?        @relation(fields: [serverId], references: [id], onDelete: Restrict)
  events            ProvisioningEvent[]

  @@map("provisioning_runs")
}

/// Historial de una instalación: solo se agrega
model ProvisioningEvent {
  id        String             @id @default(uuid(7)) @db.Uuid
  runId     String             @map("run_id") @db.Uuid
  status    ProvisioningStatus
  level     String
  message   String
  data      Json               @default("{}")
  source    String
  userId    String?            @map("user_id") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  run ProvisioningRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, createdAt])
  @@map("provisioning_events")
}
