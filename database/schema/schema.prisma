}

/// Nota interna del equipo: nunca se envía al cliente ni a la IA
model ConversationNote {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorId       String?  @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@map("conversation_notes")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SenderType {
  CUSTOMER
  BOT
  AGENT
  SYSTEM
}

model Message {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  direction         MessageDirection
  senderType        SenderType       @map("sender_type")
  senderUserId      String?          @map("sender_user_id") @db.Uuid
  type              String           @default("text")
  content           String
  /// wamid u otro id del proveedor
  providerMessageId String?          @map("provider_message_id")
  /// Entrada: received. Salida: queued → sent → delivered → read | failed
  status            String?
  errorCode         Int?             @map("error_code")
  errorMessage      String?          @map("error_message")
  /// Hora en que lo emitió el proveedor (timestamp de WhatsApp)
  providerTimestamp DateTime?        @map("provider_timestamp") @db.Timestamptz(3)
  /// Mensaje de salida que generó este registro
  outboundId        String?          @unique @map("outbound_id") @db.Uuid
  /// Id del mensaje espejo en Chatwoot (FASE 5)
  chatwootMessageId Int?             @map("chatwoot_message_id")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerMessageId])
  @@unique([tenantId, chatwootMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

enum EventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Registro de webhooks entrantes. Tabla de SISTEMA: sin acceso para el rol de ejecución.
model InboundEvent {
  id          String      @id @default(uuid(7)) @db.Uuid
  provider    String
  /// Id único del proveedor (wamid, id de evento de Chatwoot...)
  externalId  String      @map("external_id")
  tenantId    String?     @map("tenant_id") @db.Uuid
  payload     Json
  status      EventStatus @default(RECEIVED)
  attempts    Int         @default(0)
  error       String?
  receivedAt  DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?   @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([status, receivedAt])
  @@map("inbound_events")
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
}

model OutboundMessage {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  conversationId    String         @map("conversation_id") @db.Uuid
  idempotencyKey    String         @map("idempotency_key")
  payload           Json
  status            OutboundStatus @default(QUEUED)
  attempts          Int            @default(0)
  providerMessageId String?        @map("provider_message_id")
  error             String?
  errorCode         Int?           @map("error_code")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)

  @@unique([tenantId, idempotencyKey])
  @@index([status, createdAt])
  @@map("outbound_messages")
}

// ----------------------------------------------------------------- Configuración

model AiSettings {
  tenantId        String    @id @map("tenant_id") @db.Uuid
  /// Interruptor operativo (inmediato, no pasa por borrador)
  isEnabled       Boolean   @default(true) @map("is_enabled")
  /// Configuración publicada (la que usa el asistente con los clientes). Esquema: apps/api/src/ai/ai-profile.ts
