{
  "id": "aisaFlujo03Pedid",
  "name": "03 · Pedido nuevo (notificación)",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "d2178917-0d1f-537e-911a-2715614dea8b",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -220
      ],
      "parameters": {
        "content": "## FLUJO 3 · Registro de pedido → Notificación\nEl backend crea el pedido (validación, stock y confirmación ocurren allí, en una transacción) y deja el evento en su bandeja de salida.\nEste flujo arma el aviso y pide al backend que lo envíe por correo a los administradores.\nEl backend entrega cada aviso UNA sola vez aunque Meta o n8n repitan el evento (idempotencia por eventId).",
        "height": 200,
        "width": 720
      }
    },
    {
      "id": "6958d2d9-74cb-5707-8b5a-687b53d374cc",
      "name": "Evento del backend",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -200,
        80
      ],
      "webhookId": "5b0e5d1c-6a9f-4c42-9a43-0f6c1d0e3a03",
      "parameters": {
        "httpMethod": "POST",
        "path": "aisa-pedido-nuevo",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "aisaInternalTok1",
          "name": "AISA token interno"
        }
      }
    },
    {
      "id": "44eb6188-92b4-5898-a0c8-cb760a6d76c9",
      "name": "Armar aviso",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        60,
        80
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "eventId",
              "value": "={{ $json.body.eventId }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "callbackUrl",
              "value": "={{ $json.body.callbackUrl }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "subject",
              "value": "=Pedido nuevo #{{ $json.body.payload.number }} · {{ $json.body.payload.currency }} {{ $json.body.payload.total }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "text",
              "value": "=Se registró el pedido #{{ $json.body.payload.number }} ({{ $json.body.payload.channel === 'WHATSAPP' ? 'por WhatsApp' : 'manual' }}).\n\nCliente: {{ $json.body.payload.customerName }}\nTotal: {{ $json.body.payload.currency }} {{ $json.body.payload.total }}\n\nProductos:\n{{ $json.body.payload.items.map(i => '- ' + i.quantity + ' x ' + i.name).join('\\n') }}\n\n—\nEmpresa: {{ $json.body.tenantName }}\nEvento: {{ $json.body.eventId }} ({{ $json.body.occurredAt }})\nMensaje automático de AI Sales Assistant.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "ba0f9288-f810-509e-bd7a-ab06269cb805",
      "name": "Avisar a administradores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callbackUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ eventId: $json.eventId, subject: $json.subject, text: $json.text }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "aisaInternalTok1",
          "name": "AISA token interno"
        }
      }
    }
  ],
  "connections": {
    "Evento del backend": {
      "main": [
        [
          {
            "node": "Armar aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar aviso": {
      "main": [
        [
          {
            "node": "Avisar a administradores",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "pinData": {},
  "tags": []
}