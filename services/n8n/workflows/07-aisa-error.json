      ],
      "parameters": {
        "content": "## FLUJO 7 · Recuperación de errores\nError → registro (backend) → reintento controlado (cola del worker según los códigos de Meta; bandeja de salida con espera creciente) → alerta administrativa (este flujo).\nSi n8n no responde tras 8 intentos, el backend marca el evento como fallido y deja el aviso dentro del panel.",
        "height": 200,
        "width": 720
      }
    },
    {
      "id": "7e65b790-3a90-5f4c-a274-d9ac6414360b",
      "name": "Evento del backend",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -200,
        80
      ],
      "webhookId": "5b0e5d1c-6a9f-4c42-9a43-0f6c1d0e3a07",
      "parameters": {
        "httpMethod": "POST",
        "path": "aisa-error",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "aisaInternalTok1",
          "name": "AISA token interno"
        }
      }
    },
    {
      "id": "84b4bbf1-435e-5e34-a2f7-2351a70afcae",
      "name": "Armar aviso",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        60,
        80
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "eventId",
              "value": "={{ $json.body.eventId }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "callbackUrl",
              "value": "={{ $json.body.callbackUrl }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "subject",
              "value": "={{ $json.body.payload.source === 'whatsapp.token_expired' ? 'WhatsApp desconectado: token caducado' : 'Mensaje de WhatsApp no entregado' }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "text",
              "value": "={{ $json.body.payload.source === 'whatsapp.token_expired' ? 'El token de acceso de Meta del número ' + ($json.body.payload.displayPhone || '') + ' caducó o fue revocado. Los mensajes no saldrán hasta que lo actualices en Integraciones.' : 'Un mensaje a un cliente no se pudo entregar por WhatsApp.\\n\\nMotivo: ' + $json.body.payload.error + ($json.body.payload.code ? ' (código ' + $json.body.payload.code + ')' : '') + '\\nConversación: ' + $json.body.payload.conversationId }}\n\n—\nEmpresa: {{ $json.body.tenantName }}\nEvento: {{ $json.body.eventId }} ({{ $json.body.occurredAt }})\nMensaje automático de AI Sales Assistant.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "7ae86465-0fe8-587d-8ec1-84243eeed953",
      "name": "Avisar a administradores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callbackUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ eventId: $json.eventId, subject: $json.subject, text: $json.text }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "aisaInternalTok1",
          "name": "AISA token interno"
        }
      }
    }
